<?xml version="1.0"?>
<!--
/**
 * Montu Affiliate Tracking Extension - Storefront Events
 *
 * Reads the shopper's affiliate cookie. Storefront and REST checkout only
 * (see etc/webapi_rest/events.xml): the admin area never reads the cookie.
 *
 * @category  Montu
 * @package   Montu_Affiliate
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <!-- Save the affiliate code from the cookie on the cart -->
    <event name="checkout_cart_save_after">
        <observer name="montu_affiliate_save_to_quote"
                  instance="Montu\Affiliate\Observer\SaveAffiliateToQuote"/>
    </event>

    <!-- Cookie-only code (no cart save saw it): write the quote row before the order exists -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="montu_affiliate_save_on_submit"
                  instance="Montu\Affiliate\Observer\SaveAffiliateToQuote"/>
    </event>

</config>
