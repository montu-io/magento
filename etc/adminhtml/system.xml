<?xml version="1.0"?>
<!--
/**
 * Montu Affiliate Tracking Extension - Admin Configuration
 *
 * Each group lives in its own file under etc/adminhtml/system/.
 *
 * @category  Montu
 * @package   Montu_Affiliate
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="montu" translate="label" sortOrder="500">
            <label>Montu</label>
        </tab>
        <section id="montu_affiliate" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Affiliate Tracking</label>
            <tab>montu</tab>
            <resource>Montu_Affiliate::config</resource>
            <include path="Montu_Affiliate::system/general.xml"/>
            <include path="Montu_Affiliate::system/webhook.xml"/>
            <include path="Montu_Affiliate::system/events.xml"/>
            <include path="Montu_Affiliate::system/filters.xml"/>
            <include path="Montu_Affiliate::system/data.xml"/>
            <include path="Montu_Affiliate::system/queue.xml"/>
            <include path="Montu_Affiliate::system/storefront.xml"/>
            <include path="Montu_Affiliate::system/appearance.xml"/>
        </section>
    </system>
</config>
