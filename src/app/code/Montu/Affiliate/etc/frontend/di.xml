<?xml version="1.0"?>
<!--
/**
 * Montu Affiliate Tracking Extension - Frontend DI Configuration
 *
 * Registers the custom router that maps the public /storefront/{code} URL
 * (configurable prefix) to the affiliate storefront controller.
 *
 * @category  Montu
 * @package   Montu_Affiliate
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="montu_affiliate_storefront" xsi:type="array">
                    <item name="class" xsi:type="string">Montu\Affiliate\Controller\Router</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">35</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
