<?xml version="1.0"?>
<!--
/**
 * Montu Affiliate Tracking Extension - Dependency Injection Configuration
 *
 * @category  Montu
 * @package   Montu_Affiliate
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Repository Interface Preference -->
    <preference for="Montu\Affiliate\Api\AffiliateTrackingRepositoryInterface"
                type="Montu\Affiliate\Model\AffiliateTrackingRepository"/>

    <!-- Module logger: var/log/montu_affiliate.log, minimum level from the settings -->
    <virtualType name="Montu\Affiliate\Logger\Handler" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">montu_affiliate</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Montu\Affiliate\Logger\Handler\System</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Inject custom logger into classes -->
    <type name="Montu\Affiliate\Service\WebhookService">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Model\AffiliateTrackingRepository">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Model\WebhookLogRepository">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Observer\SaveAffiliateToQuote">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Observer\CopyAffiliateToOrder">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Observer\RecordOrderEvents">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Cron\ProcessWebhooks">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Controller\Router">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Controller\Storefront\Index">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Service\RecommendationClient">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <type name="Montu\Affiliate\Model\Storefront\CollectionBuilder">
        <arguments>
            <argument name="logger" xsi:type="object">Montu\Affiliate\Logger\Handler</argument>
        </arguments>
    </type>

    <!-- Admin Event Log grid -->
    <type name="Montu\Affiliate\Model\ResourceModel\WebhookLog\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">montu_affiliate_webhook_log</argument>
            <argument name="resourceModel" xsi:type="string">Montu\Affiliate\Model\ResourceModel\WebhookLog</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="montu_affiliate_event_log_listing_data_source" xsi:type="string">Montu\Affiliate\Model\ResourceModel\WebhookLog\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

</config>
