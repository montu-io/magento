<?php
/**
 * Montu Affiliate Tracking Extension - Affiliate Storefront Template
 *
 * Amazon-style, responsive, paginated affiliate storefront. Products are
 * rendered with Magento's native helpers (image, price, configurable swatches,
 * AJAX add-to-cart) via Block\Storefront\ProductList; list filters and the pager
 * come from ViewModel\Storefront.
 *
 * @category  Montu
 * @package   Montu_Affiliate
 * @var \Montu\Affiliate\Block\Storefront\ProductList $block
 */

use Magento\Framework\App\Action\Action;

$viewModel = $block->getViewModel();
$collection = $block->getLoadedProductCollection();

$affiliateCode = $viewModel->getAffiliateCode();
$affiliateName = $viewModel->getAffiliateName();
$affiliatePicture = $viewModel->getAffiliateProfilePicture();
$affiliateLabel = $affiliateName !== '' ? $affiliateName : $affiliateCode;
$filters = $viewModel->getListFilters();
$imageId = 'category_page_grid';
$themeMode = $viewModel->getThemeMode();
$appearanceVars = $viewModel->getAppearanceVars();
?>
<div class="montu-storefront" data-montu-theme-mode="<?= $block->escapeHtmlAttr($themeMode) ?>">
    <div class="montu-storefront__header">
        <?php if ($affiliatePicture): ?>
            <img class="montu-storefront__avatar"
                 src="<?= $block->escapeUrl($affiliatePicture) ?>"
                 alt="<?= $block->escapeHtmlAttr($affiliateLabel) ?>"
                 width="72" height="72"/>
        <?php endif; ?>
        <div class="montu-storefront__header-text">
            <h1 class="montu-storefront__title"><?= $block->escapeHtml(__($viewModel->getTitle())) ?></h1>
            <?php if ($affiliateLabel !== ''): ?>
                <p class="montu-storefront__subtitle">
                    <?= $block->escapeHtml(__('You are shopping with the recommendations of')) ?>
                    <strong><?= $block->escapeHtml($affiliateLabel) ?></strong>
                </p>
            <?php endif; ?>
        </div>
    </div>

    <div class="montu-storefront__body">
        <aside class="montu-storefront__filters" aria-label="<?= $block->escapeHtmlAttr(__('Lists')) ?>">
            <span class="montu-storefront__filters-title"><?= $block->escapeHtml(__('Lists')) ?></span>
            <ul class="montu-storefront__filter-list">
                <?php foreach ($filters as $filter): ?>
                    <li class="montu-storefront__filter-item<?= $filter['active'] ? ' is-active' : '' ?>">
                        <a href="<?= $block->escapeUrl($filter['url']) ?>">
                            <span class="montu-storefront__filter-name"><?= $block->escapeHtml($filter['name']) ?></span>
                            <span class="montu-storefront__filter-count"><?= (int) $filter['count'] ?></span>
                        </a>
                    </li>
                <?php endforeach; ?>
            </ul>
        </aside>

        <div class="montu-storefront__main">
            <div class="montu-storefront__toolbar">
                <span class="montu-storefront__active-list"><?= $block->escapeHtml($viewModel->getActiveListName()) ?></span>
                <?php if ($viewModel->getTotalCount() > 0): ?>
                    <span class="montu-storefront__count">
                        <?= $block->escapeHtml(__(
                            'Showing %1-%2 of %3',
                            $viewModel->getShowingFrom(),
                            $viewModel->getShowingTo(),
                            $viewModel->getTotalCount()
                        )) ?>
                    </span>
                <?php endif; ?>
            </div>

            <?php /* count() over the already-loaded items avoids a separate COUNT(*) query. */ ?>
            <?php if (!count($collection->getItems())): ?>
                <div class="message info empty">
                    <span><?= $block->escapeHtml(__('There are no recommended products to show right now.')) ?></span>
                </div>
            <?php else: ?>
                <ol class="products list items product-items montu-storefront__grid">
                    <?php foreach ($collection as $product): ?>
                        <?php $postParams = $block->getAddToCartPostParams($product); ?>
                        <li class="item product product-item montu-storefront__item"
                            data-montu-product-id="<?= (int) $product->getId() ?>">
                            <div class="product-item-info">
                                <a href="<?= $block->escapeUrl($block->getProductUrl($product)) ?>"
                                   class="product-item-photo" tabindex="-1">
                                    <?= $block->getImage($product, $imageId)->toHtml() ?>
                                </a>
                                <div class="product-item-details">
                                    <strong class="product-item-name">
                                        <a class="product-item-link"
                                           href="<?= $block->escapeUrl($block->getProductUrl($product)) ?>">
                                            <?= $block->escapeHtml($product->getName()) ?>
                                        </a>
                                    </strong>

                                    <?= $block->getProductPrice($product) ?>

                                    <?= $block->getProductDetailsHtml($product) ?>

                                    <div class="product-item-inner">
                                        <div class="product-item-actions">
                                            <div class="actions-primary">
                                                <form data-role="tocart-form"
                                                      data-product-sku="<?= $block->escapeHtmlAttr($product->getSku()) ?>"
                                                      action="<?= $block->escapeUrl($postParams['action']) ?>"
                                                      method="post">
                                                    <input type="hidden" name="product" value="<?= (int) $postParams['data']['product'] ?>"/>
                                                    <input type="hidden"
                                                           name="<?= /* @noEscape */ Action::PARAM_NAME_URL_ENCODED ?>"
                                                           value="<?= $block->escapeHtmlAttr($postParams['data'][Action::PARAM_NAME_URL_ENCODED]) ?>"/>
                                                    <?= $block->getBlockHtml('formkey') ?>
                                                    <button type="submit"
                                                            class="action tocart primary"
                                                            title="<?= $block->escapeHtmlAttr(__('Add to Cart')) ?>">
                                                        <span><?= $block->escapeHtml(__('Add to Cart')) ?></span>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    <?php endforeach; ?>
                </ol>

                <?php if ($viewModel->getTotalPages() > 1): ?>
                    <nav class="montu-storefront__pager" aria-label="<?= $block->escapeHtmlAttr(__('Pagination')) ?>">
                        <?php if ($viewModel->hasPrev()): ?>
                            <a class="montu-storefront__page montu-storefront__page--prev"
                               href="<?= $block->escapeUrl($viewModel->getPrevUrl()) ?>"
                               rel="prev"><?= $block->escapeHtml(__('Previous')) ?></a>
                        <?php endif; ?>
                        <?php foreach ($viewModel->getPageWindow() as $page): ?>
                            <?php if ($page['current']): ?>
                                <span class="montu-storefront__page is-current" aria-current="page"><?= (int) $page['num'] ?></span>
                            <?php else: ?>
                                <a class="montu-storefront__page" href="<?= $block->escapeUrl($page['url']) ?>"><?= (int) $page['num'] ?></a>
                            <?php endif; ?>
                        <?php endforeach; ?>
                        <?php if ($viewModel->hasNext()): ?>
                            <a class="montu-storefront__page montu-storefront__page--next"
                               href="<?= $block->escapeUrl($viewModel->getNextUrl()) ?>"
                               rel="next"><?= $block->escapeHtml(__('Next')) ?></a>
                        <?php endif; ?>
                    </nav>
                <?php endif; ?>
            <?php endif; ?>
        </div>
    </div>

    <div class="montu-storefront__cta">
        <a class="action primary" href="<?= $block->escapeUrl($viewModel->getStoreUrl()) ?>">
            <span><?= $block->escapeHtml(__('Continue shopping')) ?></span>
        </a>
    </div>
</div>

<?php // Native AJAX add-to-cart (CSP-safe, declarative). ?>
<script type="text/x-magento-init">
    {"[data-role=tocart-form]": {"Magento_Catalog/js/catalog-add-to-cart": {}}}
</script>

<?php // Montu-recommended default swatch selection, applied after swatch init. ?>
<script type="application/json" id="montu-storefront-selections"><?= /* @noEscape */ $block->getRecommendedSelectionsJson() ?></script>
<script src="<?= $block->escapeUrl($block->getPreselectScriptUrl()) ?>"></script>

<?php // White-label: adopt the merchant theme's own colours at runtime. ?>
<script src="<?= $block->escapeUrl($block->getViewFileUrl('Montu_Affiliate::js/storefront-theme.js')) ?>"></script>

<style>
    /*
     * White-label: EVERY colour, the card surface, the corner radius, the body
     * text colour and the font are driven by CSS custom properties. The defaults
     * below track a neutral storefront palette; colours/typography the merchant
     * sets in admin (Stores > Config > Montu > Appearance) are emitted in the
     * scoped block right after this one, and in "auto" mode storefront-theme.js
     * samples the live merchant theme at runtime and overrides the variables so
     * the page always matches the store. Text colour and font default to
     * `inherit`, so an unstyled page already adopts the store theme typography.
     */
    .montu-storefront {
        --montu-accent: #1979c3;
        --montu-accent-contrast: #ffffff;
        --montu-accent-soft: rgba(25, 121, 195, 0.12);
        --montu-border: #e3e3e3;
        --montu-muted: #6d6d6d;
        --montu-surface: #ffffff;
        --montu-radius: 10px;
        max-width: 1440px; margin: 0 auto; padding: 20px;
        color: var(--montu-text, inherit);
        font-family: var(--montu-font, inherit);
    }
    .montu-storefront__header { display: flex; align-items: center; gap: 18px;
        margin-bottom: 24px; padding-bottom: 16px; border-bottom: 3px solid var(--montu-accent); }
    .montu-storefront__avatar { width: 72px; height: 72px; flex: 0 0 auto; border-radius: 50%;
        object-fit: cover; border: 2px solid var(--montu-accent); background: var(--montu-accent-soft); }
    .montu-storefront__header-text { min-width: 0; }
    .montu-storefront__title { margin: 0 0 6px; color: var(--montu-text, inherit); }
    .montu-storefront__subtitle { color: var(--montu-muted); font-size: 1.4rem; margin: 0; }
    .montu-storefront__subtitle strong { color: var(--montu-accent); }
    .montu-storefront__body { display: grid; grid-template-columns: 240px 1fr; gap: 28px; align-items: start; }
    .montu-storefront__filters-title { display: block; font-weight: 700; margin-bottom: 10px;
        text-transform: uppercase; letter-spacing: .04em; font-size: 1.2rem; color: var(--montu-muted); }
    .montu-storefront__filter-list { list-style: none; margin: 0; padding: 0; }
    .montu-storefront__filter-item a { display: flex; justify-content: space-between; gap: 8px;
        padding: 9px 12px; border-radius: calc(var(--montu-radius) * 0.6); color: inherit; text-decoration: none;
        border: 1px solid transparent; transition: background .15s ease, color .15s ease; }
    .montu-storefront__filter-item a:hover { background: var(--montu-accent-soft); }
    .montu-storefront__filter-item.is-active a { background: var(--montu-accent-soft);
        color: var(--montu-accent); font-weight: 700; }
    .montu-storefront__filter-count { color: var(--montu-muted); }
    .montu-storefront__filter-item.is-active .montu-storefront__filter-count { color: var(--montu-accent); }
    .montu-storefront__toolbar { display: flex; justify-content: space-between; align-items: baseline;
        gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .montu-storefront__active-list { font-size: 1.8rem; font-weight: 700; color: var(--montu-text, inherit); }
    .montu-storefront__count { color: var(--montu-muted); }
    .montu-storefront__grid { display: grid; gap: 20px; list-style: none; margin: 0; padding: 0;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
    .montu-storefront__item { border: 1px solid var(--montu-border); border-radius: var(--montu-radius);
        padding: 14px; background: var(--montu-surface); transition: box-shadow .18s ease, transform .18s ease; }
    .montu-storefront__item:hover { box-shadow: 0 8px 24px rgba(0, 0, 0, .08); transform: translateY(-2px); }
    .montu-storefront__item .product-item-info { width: 100%; }
    .montu-storefront__pager { display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
        justify-content: center; margin-top: 32px; }
    .montu-storefront__page { padding: 8px 12px; border: 1px solid var(--montu-border);
        border-radius: calc(var(--montu-radius) * 0.6);
        text-decoration: none; color: inherit; transition: border-color .15s ease; }
    .montu-storefront__page:hover { border-color: var(--montu-accent); color: var(--montu-accent); }
    .montu-storefront__page.is-current { background: var(--montu-accent);
        color: var(--montu-accent-contrast); border-color: var(--montu-accent); }
    .montu-storefront__cta { text-align: center; margin-top: 36px; }

    @media (max-width: 768px) {
        .montu-storefront__body { grid-template-columns: 1fr; }
        .montu-storefront__filters { position: sticky; top: 0; z-index: 1; background: var(--montu-surface); padding: 8px 0; }
        .montu-storefront__filter-list { display: flex; gap: 8px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .montu-storefront__filter-item a { white-space: nowrap; border: 1px solid var(--montu-border); }
        .montu-storefront__grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
    }
</style>
<?php /* Admin-configured appearance overrides (Manual mode, or Auto-mode seed). */ ?>
<?php if ($appearanceVars !== []): ?>
<style>
    .montu-storefront {
        <?php foreach ($appearanceVars as $name => $value): ?>
        <?= /* @noEscape - keys are fixed --montu-* names, values are sanitised CSS tokens */ $name ?>: <?= /* @noEscape */ $value ?>;
        <?php endforeach; ?>
    }
</style>
<?php endif; ?>
