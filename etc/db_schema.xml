<?xml version="1.0"?>
<!--
/**
 * Montu Affiliate Tracking Extension - Database Schema
 * 
 * Creates separate tables for affiliate tracking data
 * Does NOT modify any Magento core tables
 *
 * @category  Montu
 * @package   Montu_Affiliate
 */
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    
    <!-- Montu Affiliate Tracking Table - Stores affiliate codes linked to quotes/orders -->
    <table name="montu_affiliate_tracking" resource="default" engine="innodb" 
           comment="Montu Affiliate Tracking Data">
        
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" 
                identity="true" comment="Entity ID"/>
        
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" 
                comment="Sales Order ID"/>
        
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="true" 
                comment="Quote ID"/>
        
        <!-- NULL for orders tracked without an affiliate code (coupon-only / "all orders" mode) -->
        <column xsi:type="varchar" name="affiliate_code" nullable="true" length="255" 
                comment="Affiliate Referral Code"/>
        
        <!-- Last order snapshot reported to Montu; drives order.updated de-duplication.
             A row is "tracked" (order.placed recorded) once fingerprint is set. -->
        <column xsi:type="varchar" name="fingerprint" nullable="true" length="64"
                comment="Fingerprint of the last order state recorded"/>
        
        <column xsi:type="varchar" name="last_state" nullable="true" length="32"
                comment="Order state at the last recorded event"/>
        
        <column xsi:type="varchar" name="last_status" nullable="true" length="64"
                comment="Order status at the last recorded event"/>
        
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" 
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" 
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        
        <!-- Primary Key -->
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        
        <!-- Unique constraint on order_id (one affiliate per order) -->
        <constraint xsi:type="unique" referenceId="MONTU_AFFILIATE_TRACKING_ORDER_ID_UNIQUE">
            <column name="order_id"/>
        </constraint>
        
        <!-- Index on quote_id for fast lookups during checkout -->
        <index referenceId="MONTU_AFFILIATE_TRACKING_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
        
        <!-- Index on affiliate_code for reporting queries -->
        <index referenceId="MONTU_AFFILIATE_TRACKING_AFFILIATE_CODE" indexType="btree">
            <column name="affiliate_code"/>
        </index>
        
    </table>

    <!-- Montu Webhook Log Table - the event outbox: one row per event (order.placed,
         order.updated, creditmemo.created) with its payload snapshot, delivery
         status and retry state -->
    <table name="montu_affiliate_webhook_log" resource="default" engine="innodb"
           comment="Montu Affiliate Webhook Log">
        
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false"
                identity="true" comment="Entity ID"/>
        
        <!-- Nullable only so the upgrade can add the unique column to existing rows;
             rows queued by v1 keep NULL and the module always sets it. -->
        <column xsi:type="varchar" name="event_id" nullable="true" length="36"
                comment="Event UUID v4 (sent as event_id / X-Montu-Event-Id)"/>
        
        <column xsi:type="varchar" name="event_type" nullable="false" length="64" default="order.placed"
                comment="Event type: order.placed, order.updated, creditmemo.created, product.*, collection.*"/>

        <!-- NULL for catalog events (product.*, collection.*): they belong to no
             order, so the per-order FIFO never holds them back -->
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true"
                comment="Sales Order ID (NULL for catalog events)"/>

        <column xsi:type="int" name="subject_id" unsigned="true" nullable="true"
                comment="Product or category id of a catalog event (NULL for order events)"/>
        
        <!-- Fingerprint of a catalog event's content (updated_at left out): an event
             whose content equals the last one sent for the subject is skipped -->
        <column xsi:type="varchar" name="content_hash" nullable="true" length="40"
                comment="SHA-1 of a catalog event's content; '-' on a requeued row: send even if unchanged"/>

        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="true"
                comment="Store view of the order"/>
        
        <column xsi:type="varchar" name="affiliate_code" nullable="false" length="255"
                comment="Affiliate Referral Code"/>
        
        <column xsi:type="varchar" name="trigger_event" nullable="true" length="128"
                comment="Magento event that recorded the event"/>
        
        <column xsi:type="varchar" name="dedupe_key" nullable="true" length="191"
                comment="order.placed:{order_id}, creditmemo.created:{creditmemo_id}, order.updated:{event_id}, catalog:{store}:{product|category}:{id} while a catalog event waits to be built"/>

        <!-- Order events: snapshot taken when recorded. Catalog events: NULL until the
             cron builds them (deletions are built when recorded). Rows queued by v1 have
             neither payload nor event_id and are never sent. -->
        <column xsi:type="mediumtext" name="payload" nullable="true"
                comment="JSON body of the event"/>

        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending"
                comment="Status: pending, processing, success, failed, max_retries, skipped"/>
        
        <column xsi:type="smallint" name="retry_count" unsigned="true" nullable="false" default="0"
                comment="Number of retry attempts"/>
        
        <column xsi:type="smallint" name="max_retries" unsigned="true" nullable="false" default="5"
                comment="Maximum retry attempts"/>
        
        <column xsi:type="int" name="http_status_code" unsigned="true" nullable="true"
                comment="Last HTTP response status code"/>
        
        <column xsi:type="text" name="response_body" nullable="true"
                comment="Last response body"/>
        
        <column xsi:type="text" name="error_message" nullable="true"
                comment="Last error message"/>
        
        <column xsi:type="timestamp" name="next_retry_at" on_update="false" nullable="true"
                comment="Next retry scheduled time"/>
        
        <column xsi:type="timestamp" name="last_attempt_at" on_update="false" nullable="true"
                comment="Last attempt timestamp"/>
        
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        
        <!-- Primary Key -->
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        
        <constraint xsi:type="unique" referenceId="MONTU_AFFILIATE_WEBHOOK_LOG_EVENT_ID">
            <column name="event_id"/>
        </constraint>
        
        <constraint xsi:type="unique" referenceId="MONTU_AFFILIATE_WEBHOOK_LOG_DEDUPE_KEY">
            <column name="dedupe_key"/>
        </constraint>
        
        <!-- Per-order FIFO lookups -->
        <index referenceId="MONTU_AFFILIATE_WEBHOOK_LOG_ORDER_ID_ENTITY_ID" indexType="btree">
            <column name="order_id"/>
            <column name="entity_id"/>
        </index>
        
        <!-- Queue processing (status) and retention purge (status + age); replaces the
             status-only index of v1, which this one covers -->
        <index referenceId="MONTU_AFFILIATE_WEBHOOK_LOG_STATUS_UPDATED_AT" indexType="btree">
            <column name="status"/>
            <column name="updated_at"/>
        </index>
        
        <!-- Last content sent per catalog subject and store view (CatalogEventBuilder) -->
        <index referenceId="MONTU_AFFILIATE_WEBHOOK_LOG_SUBJECT_ID_STORE_ID" indexType="btree">
            <column name="subject_id"/>
            <column name="store_id"/>
        </index>
        
        <!-- Ready / waiting rows in queue order (getReadyBatch, CatalogEventBuilder) -->
        <index referenceId="MONTU_AFFILIATE_WEBHOOK_LOG_STATUS_ENTITY_ID" indexType="btree">
            <column name="status"/>
            <column name="entity_id"/>
        </index>
        
        <!-- Index on next_retry_at for retry scheduling -->
        <index referenceId="MONTU_AFFILIATE_WEBHOOK_LOG_NEXT_RETRY" indexType="btree">
            <column name="next_retry_at"/>
        </index>
        
    </table>

</schema>
