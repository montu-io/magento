<?xml version="1.0"?>
<!--
/**
 * Montu Affiliate Tracking Extension - REST Events
 *
 * The storefront checkout places the order through the REST API, which
 * carries the shopper's cookies. See etc/frontend/events.xml.
 *
 * @category  Montu
 * @package   Montu_Affiliate
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <!-- Cookie-only code (no cart save saw it): write the quote row before the order exists -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="montu_affiliate_save_on_submit"
                  instance="Montu\Affiliate\Observer\SaveAffiliateToQuote"/>
    </event>

</config>
