<?xml version="1.0"?>
<!--
/**
 * Montu Affiliate Tracking Extension - Events Configuration
 *
 * @category  Montu
 * @package   Montu_Affiliate
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    
    <!-- Save affiliate code from cookie to quote -->
    <event name="checkout_cart_save_after">
        <observer name="montu_affiliate_save_to_quote" 
                  instance="Montu\Affiliate\Observer\SaveAffiliateToQuote"/>
    </event>

    <!-- Copy affiliate code from quote to order (after order is saved) -->
    <event name="sales_model_service_quote_submit_success">
        <observer name="montu_affiliate_copy_to_order" 
                  instance="Montu\Affiliate\Observer\CopyAffiliateToOrder"/>
    </event>

    <!-- Send webhook after checkout completes (after CopyAffiliateToOrder runs) -->
    <event name="checkout_submit_all_after">
        <observer name="montu_affiliate_send_webhook" 
                  instance="Montu\Affiliate\Observer\SendOrderWebhook"/>
    </event>

</config>

