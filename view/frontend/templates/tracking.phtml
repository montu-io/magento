<?php
/**
 * Montu Affiliate Tracking Extension - Tracking Template
 *
 * Loads the affiliate tracking JS with configuration.
 *
 * @category  Montu
 * @package   Montu_Affiliate
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Montu\Affiliate\ViewModel\AffiliateConfig $viewModel
 */

$viewModel = $block->getViewModel();

if (!$viewModel->isEnabled()) {
    return;
}

// Get the static file URL
$jsUrl = $block->getViewFileUrl('Montu_Affiliate::js/tracking.js');
?>
<!-- Montu Affiliate Tracking Script. The configuration travels in a data attribute
     (not an inline <script>) so the strict CSP of Magento 2.4.7+ pages never blocks it. -->
<script src="<?= $block->escapeUrl($jsUrl) ?>"
        data-montu-config="<?= $block->escapeHtmlAttr($viewModel->getJsonConfig()) ?>"></script>
