<?xml version="1.0"?>
<!--
/**
 * Montu Affiliate Tracking Extension - Default Configuration
 *
 * @category  Montu
 * @package   Montu_Affiliate
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <montu_affiliate>
            <general>
                <enabled>0</enabled>
                <cookie_lifetime>15</cookie_lifetime>
                <url_parameter>_m_aff</url_parameter>
                <cookie_name>_montu_aff_ref_code</cookie_name>
            </general>
            <webhook>
                <enabled>0</enabled>
                <endpoint_url></endpoint_url>
                <key_id></key_id>
                <signing_secret></signing_secret>
                <send_on_order_placed>1</send_on_order_placed>
                <timeout>30</timeout>
            </webhook>
            <events>
                <send_order_updated>1</send_order_updated>
                <send_creditmemo_created>1</send_creditmemo_created>
            </events>
            <catalog>
                <send_product_created>0</send_product_created>
                <send_product_updated>0</send_product_updated>
                <send_product_deleted>0</send_product_deleted>
                <send_collection_created>0</send_collection_created>
                <send_collection_updated>0</send_collection_updated>
                <send_collection_deleted>0</send_collection_deleted>
                <brand_attribute>manufacturer</brand_attribute>
            </catalog>
            <filters>
                <orders_to_send>affiliate_code_or_coupon</orders_to_send>
                <coupon_prefixes></coupon_prefixes>
                <excluded_customer_groups></excluded_customer_groups>
            </filters>
            <data>
                <customer_data>hashed</customer_data>
            </data>
            <queue>
                <cron_expr>*/5 * * * *</cron_expr>
                <batch_size>500</batch_size>
                <max_retries>5</max_retries>
                <retention_days>30</retention_days>
                <log_level>warning</log_level>
            </queue>
            <storefront>
                <enabled>0</enabled>
                <route_path>storefront</route_path>
                <title>Recommended products</title>
                <products_endpoint></products_endpoint>
                <products_limit>12</products_limit>
                <locale>en_US</locale>
                <fallback>empty</fallback>
                <hide_out_of_stock>1</hide_out_of_stock>
            </storefront>
            <appearance>
                <theme_mode>auto</theme_mode>
                <accent_color></accent_color>
                <accent_text_color></accent_text_color>
                <text_color></text_color>
                <muted_color></muted_color>
                <border_color></border_color>
                <surface_color></surface_color>
                <card_radius></card_radius>
                <font_family></font_family>
            </appearance>
        </montu_affiliate>
    </default>
</config>

